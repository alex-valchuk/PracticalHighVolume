# Copy this file to .env and adjust values.
# .env is git-ignored; .env.example is committed as documentation.

# Target URL for the /api proxy during `npm start` / `npm run dev`.
#
# Local IDE (Visual Studio, dotnet run):
#   API_TARGET=https://localhost:50943
#
# Kubernetes (kind) via ingress:
#   API_TARGET=http://api.flights.local
#
# Remote staging:
#   API_TARGET=https://api.staging.example.com
#
API_TARGET=https://localhost:50943